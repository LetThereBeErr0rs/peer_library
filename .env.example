# Peer Library configuration. Copy to `.env` and fill in real values.
# NEVER commit a real .env — it is gitignored.

# ---- Core ----
# development | production | testing
FLASK_ENV=development
# Generate a strong value for production, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- Database ----
# Local development leaves this blank to use SQLite (instance/peer_library.db).
# Production: a Supabase/PostgreSQL connection string. postgres:// and
# postgresql:// are both accepted and upgraded to the psycopg driver.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ---- Storage ----
# local | supabase.  Production MUST be supabase (containers are ephemeral).
STORAGE_BACKEND=local
UPLOAD_FOLDER=uploads

# ---- Supabase (server-side ONLY — never expose the service key to the browser) ----
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_BUCKET=resources
# Signed download URL lifetime in seconds.
SUPABASE_SIGNED_URL_TTL=120

# ---- Sessions / cookies ----
# Set to true in production (HTTPS). Leave false for local http.
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME=86400

# ---- Rate limiting ----
RATELIMIT_ENABLED=true
# memory:// for a single process; use redis://… for multi-worker production.
RATELIMIT_STORAGE_URI=memory://

# ---- Pagination ----
RESOURCES_PER_PAGE=12
