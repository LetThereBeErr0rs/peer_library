{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://YOUR-RENDER-BACKEND.onrender.com/api/:path*"
    },
    {
      "source": "/download/:path*",
      "destination": "https://YOUR-RENDER-BACKEND.onrender.com/download/:path*"
    },
    {
      "source": "/contribute",
      "destination": "/frontend/contribute.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/register",
      "destination": "/frontend/register.html"
    },
    {
      "source": "/resource",
      "destination": "/frontend/resource.html"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
